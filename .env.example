NODE_ENV=development
PORT=10000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cypher_school
DATABASE_SSL=false
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM=Cypher-School <no-reply@your-verified-domain.example>
# Optional: set this to the exact deployed URL after Render creates the service.
# APP_BASE_URL=https://your-service.onrender.com
